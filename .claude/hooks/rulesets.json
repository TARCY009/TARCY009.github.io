{
  "_説明": "見張り役(guard.py)の対応表。paths に当てはまるファイルを書き換える前に、rules のメモが読み込まれている必要がある。checks は保存(コミット)前に流す答え合わせ(.claude/checks/run.py の名前)。",
  "sets": {
    "gbl": {
      "label": "GBL・ロケット団・対戦記録・模擬戦",
      "rules": ".claude/rules/gbl.md",
      "checklist": ".claude/checklists/gbl.md",
      "checks": [
        "gbl-engine",
        "mock-fx"
      ],
      "paths": [
        "assets/gbl-app.js",
        "assets/sound.js",
        "assets/gbl.css",
        "assets/pvp-engine.js",
        "assets/meta_lists.js",
        "assets/meta_moves.js",
        "assets/meta_past.js",
        "assets/rocket_roster.js",
        "gbl/**",
        "rocket/**",
        "battlelog/**",
        "pvp-tests/**",
        "build_meta.py",
        "build_past_cups.py",
        "build_help.py",
        "build_pvp_data.py"
      ]
    },
    "raid": {
      "label": "レイド火力チェッカー・レイドシミュレーター・タイプ別火力",
      "rules": ".claude/rules/raid.md",
      "checklist": ".claude/checklists/raid.md",
      "checks": [
        "raid-engine"
      ],
      "paths": [
        "template.html",
        "dps/**",
        "raid/**",
        "assets/raid-engine.js",
        "type-dps/**"
      ]
    },
    "iv": {
      "label": "個体値チェッカー",
      "rules": ".claude/rules/iv.md",
      "checklist": ".claude/checklists/iv.md",
      "checks": [
        "iv-calc"
      ],
      "paths": [
        "iv-checker/**"
      ]
    },
    "gym": {
      "label": "ジム挑戦・ジム防衛・マックスバトル対策",
      "rules": ".claude/rules/gym.md",
      "checklist": ".claude/checklists/gym.md",
      "checks": [
        "max-attacker"
      ],
      "paths": [
        "gym-attack/**",
        "gym-defense/**",
        "max-battle/**"
      ]
    },
    "breakpoint": {
      "label": "GBLブレイクポイント",
      "rules": ".claude/rules/breakpoint.md",
      "checklist": ".claude/checklists/breakpoint.md",
      "checks": [
        "gbl-engine"
      ],
      "paths": [
        "breakpoint/**"
      ]
    },
    "dex": {
      "label": "ステータス図鑑・わざ図鑑・耐久指数・マックスバトル タイプ別",
      "rules": ".claude/rules/dex.md",
      "checklist": ".claude/checklists/dex.md",
      "checks": [],
      "paths": [
        "pokedex/**",
        "move-dex/**",
        "bulk/**",
        "max-type/**"
      ]
    }
  }
}
